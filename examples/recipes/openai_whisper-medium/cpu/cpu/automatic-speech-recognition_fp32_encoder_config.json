{
  "export": {
    "opset_version": 17,
    "batch_size": 1,
    "export_params": true,
    "do_constant_folding": true,
    "verbose": false,
    "dynamo": false,
    "enable_hierarchy_tags": true,
    "clean_onnx": false,
    "hierarchy_tag_format": "full",
    "input_tensors": [
      {
        "name": "input_features",
        "dtype": "float32",
        "shape": [
          1,
          80,
          3000
        ],
        "value_range": [
          0,
          1
        ]
      }
    ],
    "output_tensors": [
      {
        "name": "encoder_hidden_states"
      }
    ],
    "compatibility": {
      "transformers_attention": "eager"
    }
  },
  "optim": {},
  "quant": null,
  "compile": null,
  "loader": {
    "task": "feature-extraction",
    "model_class": "WhisperEncoderWrapper",
    "model_type": "whisper"
  }
}